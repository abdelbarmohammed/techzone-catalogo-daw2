---
// Propiedades que acepta el layout
interface Props {
  titulo: string;
  descripcion?: string;
}

// Desestructuración de las props
const { titulo, descripcion = 'TechZone - Tu tienda de tecnología' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <title>{titulo} | GaleríaTech</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-gray-50 flex flex-col">
    <!-- Cabecera -->
    <header class="bg-white shadow-sm border-b border-gray-200">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Logo -->
          <a href="/" class="text-2xl font-bold text-blue-600">
            GaleríaTech
          </a>
          
          <!-- Navegación -->
          <ul class="flex space-x-8">
            <li>
              <a href="/" class="text-gray-700 hover:text-blue-600 transition-colors">
                Inicio
              </a>
            </li>
            <li>
              <a href="/productos" class="text-gray-700 hover:text-blue-600 transition-colors">
                Productos
              </a>
            </li>
            <li>
              <a href="/blog" class="text-gray-700 hover:text-blue-600 transition-colors">
                Blog
              </a>
            </li>
            <li>
              <a href="/contacto" class="text-gray-700 hover:text-blue-600 transition-colors">
                Contacto
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </header>

    <!-- Contenido principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Pie de página -->
    <footer class="bg-gray-800 text-white py-8 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <p class="text-lg font-semibold">GaleríaTech</p>
          <p class="text-gray-400 mt-2">Tu tienda de tecnología de confianza</p>
          <p class="text-gray-500 text-sm mt-4">
            © 2026 GaleríaTech. Proyecto DAW2.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>