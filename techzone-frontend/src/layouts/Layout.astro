                  <ul class="space-y-2 text-sm text-gris">
                    <li><a class="hover:text-blanco transition" href="/privacidad">{nav.privacidad}</a></li>
                    <li><a class="hover:text-blanco transition" href="/terminos">{nav.terminos}</a></li>
