          </div>
        </footer>

        <!-- Mobile Bottom Navigation -->
        <nav class="fixed bottom-0 left-0 right-0 z-50 bg-fondo/95 backdrop-blur border-t border-borde md:hidden">
          <div class="flex justify-around items-center h-16">
            <a href="/" class="flex flex-col items-center gap-1 text-acento">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              <span class="text-xs">{nav.inicio}</span>
            </a>
            <a href="/productos" class="flex flex-col items-center gap-1 text-gris hover:text-blanco transition">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
              <span class="text-xs">{nav.productos}</span>
            </a>
            <a href="/carrito" class="flex flex-col items-center gap-1 text-gris hover:text-blanco transition relative">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              <span class="text-xs">{nav.carrito}</span>
              <span id="carrito-contador-movil" class="absolute -top-1 -right-1 h-4 w-4 rounded-full bg-acento text-fondo text-xs flex items-center justify-center hidden">0</span>
            </a>
            <a href="/contacto" class="flex flex-col items-center gap-1 text-gris hover:text-blanco transition">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <span class="text-xs">{nav.contacto}</span>
            </a>
          </div>
        </nav>

       <!-- Script Global: Contador Carrito, Toast, y Theme Toggle -->
        <script>
  import { obtenerCantidadTotal } from '../lib/carrito.js';

  // ============================================
  // THEME TOGGLE
  // ============================================
  const themeToggle = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');
  const html = document.documentElement;

  // Check saved theme or system preference
  function getTheme(): 'dark' | 'light' {
    const saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') return saved;
    return 'dark'; // Default to dark
  }

  // Apply theme
  function applyTheme(theme: 'dark' | 'light') {
    if (theme === 'light') {
      html.classList.remove('dark');
      html.classList.add('light');
      iconSun?.classList.add('hidden');
      iconMoon?.classList.remove('hidden');
    } else {
      html.classList.remove('light');
      html.classList.add('dark');
      iconSun?.classList.remove('hidden');
      iconMoon?.classList.add('hidden');
    }
    localStorage.setItem('theme', theme);
  }

  // Initialize theme
  applyTheme(getTheme());

  // Toggle theme on click
  themeToggle?.addEventListener('click', () => {
    const current = getTheme();
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });

  // ============================================
  // CART COUNTER
  // ============================================
  function actualizarContadores() {
    const cantidad = obtenerCantidadTotal();
    const contadorDesktop = document.getElementById('carrito-contador-desktop');
    const contadorMovil = document.getElementById('carrito-contador-movil');

    [contadorDesktop, contadorMovil].forEach(contador => {
      if (contador) {
        contador.textContent = cantidad.toString();
        if (cantidad > 0) {
          contador.classList.remove('hidden');
        } else {
          contador.classList.add('hidden');
        }
      }
    });
  }

  // ============================================
  // TOAST NOTIFICATIONS
  // ============================================
  function mostrarToast(mensaje: string) {
    const toast = document.getElementById('toast');
    const toastMensaje = document.getElementById('toast-mensaje');
    
    if (toast && toastMensaje) {
      toastMensaje.textContent = mensaje;
      toast.classList.remove('translate-x-full', 'opacity-0');
      
      setTimeout(() => {
        toast.classList.add('translate-x-full', 'opacity-0');
      }, 2500);
    }
  }

  // Expose for other scripts
  (window as any).mostrarToast = mostrarToast;

  // Listen for cart updates
  window.addEventListener('carrito-actualizado', () => {
    actualizarContadores();
  });

  // Initialize on load
  document.addEventListener('DOMContentLoaded', actualizarContadores);
  actualizarContadores();
</script>
      </div>
    )}
  </body>
</html>