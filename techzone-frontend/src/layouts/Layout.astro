                  <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <!-- Menú Móvil -->
            <div class="md:hidden hidden pb-4" data-menu-movil>
              <nav class="flex flex-col gap-2 pt-2 text-sm">
                <a href="/" class="rounded-xl px-3 py-2 text-gris hover:text-blanco hover:bg-panel transition">{nav.inicio}</a>
                <a href="/productos" class="rounded-xl px-3 py-2 text-gris hover:text-blanco hover:bg-panel transition">{nav.productos}</a>
                <a href="/blog" class="rounded-xl px-3 py-2 text-gris hover:text-blanco hover:bg-panel transition">{nav.blog}</a>
                <a href="/contacto" class="rounded-xl px-3 py-2 text-gris hover:text-blanco hover:bg-panel transition">{nav.contacto}</a>
              </nav>
            </div>
          </div>

          <script>
            const boton = document.querySelector("[data-boton-menu]");
            const menu = document.querySelector("[data-menu-movil]");
            if (boton && menu) {
              boton.addEventListener("click", () => {
                menu.classList.toggle("hidden");
              });
            }
          </script>
        </header>

        <!-- Contenido Principal -->
        <main class="flex-1">
          <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-8">
            <slot />
          </div>
        </main>

        <!-- Pie de Página -->
        <footer class="border-t border-borde/60 bg-fondo pb-20 md:pb-0">
