---
import { obtenerDeStrapi, STRAPI_URL_BASE } from "../lib/strapi";
import '../styles/global.css';

// Tipos
interface ConfiguracionSitio {
  nombreSitio: string;
  descripcionSitio: string;
  emailContacto: string;
  urlSitio: string;
  copyright: string;
  etiquetaTema: string;
  logo: { url: string };
  favicon: { url: string };
  facebook: string;
  instagram: string;
  twitter: string;
}

interface Navegacion {
  inicio: string;
  productos: string;
  blog: string;
  contacto: string;
  explorar: string;
  legal: string;
  privacidad: string;
  terminos: string;
  carrito: string;
  catalogo: string;
  social: string;
}

interface TextosGenerale {
  verProductos: string;
  verTodas: string;
  verMas: string;
  anadirFavoritos: string;
  compartir: string;
  enviarMensaje: string;
  enStock: string;
  agotado: string;
  tiempoLectura: string;
  productosRelacionados: string;
  articulosRelacionados: string;
  buscarPlaceholder: string;
  ordenarPor: string;
  mostrandoResultados: string;
  noResultados: string;
  cargarMas: string;
  errorCargarContenido: string;
  noProductosDestacados: string;
  simboloMoneda: string;
  flechaIzquierda: string;
  flechaDerecha: string;
  errorCargarSitio: string;
  abrirMenu: string;
}

interface Props {
  titulo?: string;
  descripcion?: string;
}

// Obtener datos
let config: ConfiguracionSitio | null = null;
let nav: Navegacion | null = null;
let textos: TextosGenerale | null = null;

try {
  const resConfig = await obtenerDeStrapi<ConfiguracionSitio>('configuracion-sitio', 'populate=*');
  config = resConfig.data;
  
  const resNav = await obtenerDeStrapi<Navegacion>('navegacion');
  nav = resNav.data;
  const resTextos = await obtenerDeStrapi<TextosGenerale>('textos-generale');
  textos = resTextos.data;
} catch (e) {
  console.error('Error cargando configuración:', e);
}

const { 
  titulo = config?.nombreSitio || 'GaleríaTech',
  descripcion = config?.descripcionSitio || ''
} = Astro.props;

const anioActual = new Date().getFullYear();
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    
    {config?.favicon?.url && (
      <link rel="icon" type="image/png" href={`${STRAPI_URL_BASE}${config.favicon.url}`} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-dvh bg-fondo text-blanco antialiased">
    {!config || !nav || !textos ? (
      <div class="min-h-dvh flex items-center justify-center">
        <p class="text-error">{textos?.errorCargarSitio || 'Error cargando el sitio'}</p>
      </div>
    ) : (
      <div class="min-h-dvh flex flex-col">
        
        <!-- Toast Notificación -->
        <div id="toast" class="fixed top-20 right-4 z-50 transform translate-x-full opacity-0 transition-all duration-300">
          <div class="bg-panel border border-acento/50 rounded-xl px-4 py-3 shadow-lg flex items-center gap-3">
            <svg class="w-5 h-5 text-acento" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span id="toast-mensaje" class="text-sm text-blanco">Producto añadido al carrito</span>
          </div>
        </div>

        <!-- Cabecera -->
        <header class="sticky top-0 z-40 border-b border-borde/60 bg-fondo/80 backdrop-blur">
          <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center justify-between gap-3">
              <!-- Logo -->
              <a href="/" class="flex items-center gap-2">
                {config.logo?.url ? (
                  <img 
                    src={`${STRAPI_URL_BASE}${config.logo.url}`} 
                    alt={config.nombreSitio}
                    class="h-20 w-auto"
                  />
                ) : (
                  <span class="grid h-8 w-8 place-items-center rounded-xl bg-acento/15 ring-1 ring-acento/30">
                    <span class="h-3 w-3 rounded-full bg-acento"></span>
                  </span>
                )}
                <span class="text-base font-semibold tracking-tight">{config.nombreSitio}</span>
              </a>

              <!-- Navegación Desktop -->
              <nav class="hidden md:flex items-center gap-6 text-sm text-gris">
                <a href="/" class="transition-colors hover:text-blanco">{nav.inicio}</a>
                <a href="/productos" class="transition-colors hover:text-blanco">{nav.productos}</a>
                <a href="/blog" class="transition-colors hover:text-blanco">{nav.blog}</a>
                <a href="/contacto" class="transition-colors hover:text-blanco">{nav.contacto}</a>
              </nav>

              <!-- Theme Toggle & Carrito Desktop -->
<div class="hidden md:flex items-center gap-2">
  <!-- Theme Toggle -->
  <button
    id="theme-toggle"
    class="p-2 rounded-xl hover:bg-panel transition cursor-pointer"
    aria-label="Cambiar tema"
  >
    <!-- Sun icon (shown in dark mode) -->
    <svg id="icon-sun" class="w-5 h-5 text-gris hover:text-blanco transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <!-- Moon icon (shown in light mode) -->
    <svg id="icon-moon" class="w-5 h-5 text-gris hover:text-blanco transition hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>
  
  <!-- Carrito -->
  <a href="/carrito" class="relative p-2 rounded-xl hover:bg-panel transition">
    <svg class="w-6 h-6 text-gris hover:text-blanco transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
    <span id="carrito-contador-desktop" class="absolute -top-1 -right-1 h-5 w-5 rounded-full bg-acento text-fondo text-xs font-bold flex items-center justify-center hidden">0</span>
  </a>
</div>

              <!-- Menú Móvil Botón -->
              <button
                type="button"
                class="md:hidden inline-flex items-center justify-center rounded-xl p-2 ring-1 ring-borde hover:bg-panel"
                aria-label={textos?.abrirMenu || 'Abrir menú'}
                data-boton-menu
              >
