---
import Layout from "../../layouts/Layout.astro";
import { obtenerDeStrapi, STRAPI_URL_BASE } from "../../lib/strapi";

// Tipos
interface PaginaProducto {
  metaTitulo: string;
  metaDescripcion: string;
  titulo: string;
  subtitulo: string;
}

interface TextosGenerale {
  buscarPlaceholder: string;
  ordenarPor: string;
  ordenarPrecioMenor: string;
  ordenarPrecioMayor: string;
  ordenarNombreAZ: string;
  ordenarRecientes: string;
  todasCategorias: string;
  mostrandoResultados: string;
  noResultados: string;
  verMas: string;
  anadirFavoritos: string;
  simboloMoneda: string;
  anadirAlCarrito: string;
  productoAnadido: string;
  filtros: string;
  categorias: string;
  rangoPrecio: string;
  marcas: string;
  limpiarFiltros: string;
}

interface Categoria {
  id: number;
  nombre: string;
  slug: string;
}

interface Producto {
  id: number;
  nombre: string;
  slug: string;
  descripcionCorta: string;
  precio: number;
  marca: string;
  imagen: { url: string };
  categoria: Categoria;
  createdAt: string;
}

// Obtener datos
let pagina: PaginaProducto | null = null;
let textos: TextosGenerale | null = null;
let categorias: Categoria[] = [];
let productos: Producto[] = [];
let error = false;

try {
  const resPagina = await obtenerDeStrapi<PaginaProducto>('pagina-producto');
  pagina = resPagina.data;

  const resTextos = await obtenerDeStrapi<TextosGenerale>('textos-generale');
  textos = resTextos.data;

  const resCategorias = await obtenerDeStrapi<Categoria[]>('categorias');
  categorias = resCategorias.data;

  const resProductos = await obtenerDeStrapi<Producto[]>('productos', 'populate=*');
  productos = resProductos.data;
} catch (e) {
  console.error('Error:', e);
  error = true;
}

// Obtener marcas únicas de los productos
const marcasUnicas = [...new Set(productos.map(p => p.marca))].sort();

// Obtener rango de precios
const precios = productos.map(p => p.precio);
const precioMin = Math.floor(Math.min(...precios));
const precioMax = Math.ceil(Math.max(...precios));

const totalProductos = productos.length;
---

<Layout titulo={pagina?.metaTitulo} descripcion={pagina?.metaDescripcion}>
  {error || !pagina || !textos ? (
    <div class="text-center py-20 text-error">
      <p>{textos?.noResultados || 'Error al cargar.'}</p>
    </div>
  ) : (
    <>
      <!-- Cabecera -->
      <section class="py-8 text-center">
        <h1 class="text-4xl font-bold mb-2">{pagina.titulo}</h1>
        <p class="text-gris">{pagina.subtitulo}</p>
      </section>

      <!-- Buscador -->
      <section class="mb-8">
        <div class="max-w-2xl mx-auto relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="buscador"
            placeholder={textos.buscarPlaceholder}
            class="w-full pl-12 pr-4 py-4 bg-panel border border-borde rounded-2xl text-blanco placeholder:text-gris focus:outline-none focus:border-acento transition"
          />
        </div>
      </section>

      <!-- Layout Principal: Sidebar + Grid -->
<div class="relative flex flex-col lg:flex-row gap-8">
  <!-- Subtle background gradient -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-acento/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
  </div>
        
        <!-- Sidebar Filtros (Mobile Toggle) -->
        <button 
          id="toggle-filtros"
          class="lg:hidden flex items-center justify-center gap-2 px-4 py-3 bg-panel border border-borde rounded-xl text-blanco"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          {textos.filtros || 'Filtros'}
        </button>

        <!-- Sidebar -->
        <aside id="sidebar-filtros" class="hidden lg:block w-full lg:w-72 flex-shrink-0">
          <div class="bg-panel border border-borde rounded-2xl p-6 sticky top-4">
            
            <!-- Header Filtros -->
            <div class="flex items-center justify-between mb-6">
              <h2 class="font-semibold text-lg">{textos.filtros || 'Filtros'}</h2>
              <button id="limpiar-filtros" class="text-sm text-acento hover:underline">
                {textos.limpiarFiltros || 'Limpiar'}
              </button>
            </div>

            <!-- Categorías (Accordion) -->
            <div class="border-b border-borde pb-4 mb-4">
              <button class="accordion-toggle flex items-center justify-between w-full py-2 text-left" data-target="categorias-content">
                <span class="font-medium">{textos.categorias || 'Categorías'}</span>
                <svg class="accordion-icon w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="categorias-content" class="accordion-content open mt-3 space-y-2">
                <label class="flex items-center gap-3 cursor-pointer group">
                  <input type="checkbox" class="filtro-categoria" value="todas" checked />
                  <span class="text-sm text-gris group-hover:text-blanco transition">{textos.todasCategorias}</span>
                </label>
                {categorias.map((cat) => (
                  <label class="flex items-center gap-3 cursor-pointer group">
                    <input type="checkbox" class="filtro-categoria" value={cat.slug} />
                    <span class="text-sm text-gris group-hover:text-blanco transition">{cat.nombre}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Rango de Precio (Accordion) -->
            <div class="border-b border-borde pb-4 mb-4">
              <button class="accordion-toggle flex items-center justify-between w-full py-2 text-left" data-target="precio-content">
                <span class="font-medium">{textos.rangoPrecio || 'Rango de Precio'}</span>
                <svg class="accordion-icon w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="precio-content" class="accordion-content open mt-3">
                <div class="space-y-4">
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gris">{textos.simboloMoneda}<span id="precio-min-label">{precioMin}</span></span>
                    <span class="text-gris">{textos.simboloMoneda}<span id="precio-max-label">{precioMax}</span></span>
                  </div>
                  <div class="relative pt-1">
                    <input
                      type="range"
                      id="precio-min"
                      min={precioMin}
                      max={precioMax}
                      value={precioMin}
                      class="w-full"
                    />
                  </div>
                  <div class="relative pt-1">
                    <input
                      type="range"
                      id="precio-max"
                      min={precioMin}
                      max={precioMax}
                      value={precioMax}
                      class="w-full"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Marcas (Accordion) -->
            <div>
              <button class="accordion-toggle flex items-center justify-between w-full py-2 text-left" data-target="marcas-content">
                <span class="font-medium">{textos.marcas || 'Marcas'}</span>
                <svg class="accordion-icon w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="marcas-content" class="accordion-content open mt-3 space-y-2 max-h-48 overflow-y-auto">
                {marcasUnicas.map((marca) => (
                  <label class="flex items-center gap-3 cursor-pointer group">
                    <input type="checkbox" class="filtro-marca" value={marca} />
                    <span class="text-sm text-gris group-hover:text-blanco transition">{marca}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </aside>

        <!-- Contenido Principal -->
        <main class="flex-1 min-w-0">
          
          <!-- Barra Superior: Contador + Ordenar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <p class="text-gris text-sm">
              <span id="contador-resultados">{totalProductos}</span> {textos.mostrandoResultados || 'productos encontrados'}
            </p>
            
            <div class="flex items-center gap-2">
              <span class="text-gris text-sm whitespace-nowrap">{textos.ordenarPor}:</span>
              <select
                id="ordenar"
                class="bg-panel border border-borde rounded-xl px-4 py-2 text-sm text-blanco focus:outline-none focus:border-acento appearance-none cursor-pointer min-w-[180px]"
              >
                <option value="recientes">{textos.ordenarRecientes}</option>
                <option value="precio-asc">{textos.ordenarPrecioMenor}</option>
                <option value="precio-desc">{textos.ordenarPrecioMayor}</option>
                <option value="nombre-asc">{textos.ordenarNombreAZ}</option>
              </select>
            </div>
          </div>

          <!-- Grid Productos -->
          <section id="grid-productos" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mb-12">
            {productos.map((producto) => (
              <article
                class="producto-card group bg-panel rounded-2xl border border-borde overflow-hidden hover:border-acento/50 transition animate-fade-in"
                data-nombre={producto.nombre.toLowerCase()}
                data-precio={producto.precio}
                data-categoria={producto.categoria?.slug || ''}
                data-marca={producto.marca}
                data-fecha={producto.createdAt}
              >
                <a href={`/productos/${producto.slug}`} class="block">
                  <div class="aspect-square bg-fondo p-6 relative">
                    {producto.imagen?.url && (
                      <img
                        src={`${STRAPI_URL_BASE}${producto.imagen.url}`}
                        alt={producto.nombre}
                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    )}
                    <button
                      class="absolute top-4 right-4 p-2.5 rounded-full bg-panel/90 hover:bg-acento hover:text-fondo transition opacity-0 group-hover:opacity-100"
                      aria-label={textos.anadirFavoritos}
                      onclick="event.preventDefault(); event.stopPropagation();"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                      </svg>
                    </button>
                    <!-- Etiqueta Categoría -->
                    {producto.categoria?.nombre && (
                      <span class="absolute top-4 left-4 px-3 py-1 bg-fondo/90 text-acento text-xs font-medium rounded-full">
                        {producto.categoria.nombre}
                      </span>
                    )}
                  </div>
                  <div class="p-5">
                    <span class="text-xs text-gris uppercase tracking-wide">{producto.marca}</span>
                    <h3 class="font-semibold text-blanco mt-1 group-hover:text-acento transition line-clamp-1">{producto.nombre}</h3>
                    <p class="text-gris text-sm mt-2 line-clamp-2">{producto.descripcionCorta}</p>
                  </div>
                </a>
                <div class="px-5 pb-5 flex items-center justify-between">
                  <span class="text-xl font-bold text-acento">{textos.simboloMoneda}{producto.precio.toLocaleString()}</span>
                  <button 
                    class="boton-carrito p-3 rounded-xl bg-acento/10 text-acento hover:bg-acento hover:text-fondo transition"
                    data-id={producto.id}
                    data-nombre={producto.nombre}
                    data-precio={producto.precio}
                    data-imagen={producto.imagen?.url ? `${STRAPI_URL_BASE}${producto.imagen.url}` : ''}
                    data-slug={producto.slug}
                    aria-label={textos.anadirAlCarrito}
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </button>
                </div>
              </article>
            ))}
          </section>

          <!-- Mensaje Sin Resultados -->
          <div id="sin-resultados" class="hidden text-center py-16">
            <svg class="w-16 h-16 mx-auto text-gris mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-gris text-lg">{textos.noResultados}</p>
            <button id="reset-filtros" class="mt-4 px-6 py-2 bg-acento/10 text-acento rounded-xl hover:bg-acento hover:text-fondo transition">
              {textos.limpiarFiltros || 'Limpiar filtros'}
            </button>
          </div>

          <!-- Paginación -->
          <nav id="paginacion" class="flex justify-center items-center gap-2 mt-8">
            <!-- Se genera dinámicamente con JS -->
          </nav>
        </main>
      </div>

      <!-- JavaScript -->
      <script>
        import { anadirAlCarrito } from '../../lib/carrito.js';

        // Elementos del DOM
        const buscador = document.getElementById('buscador') as HTMLInputElement;
        const selectOrdenar = document.getElementById('ordenar') as HTMLSelectElement;
        const gridProductos = document.getElementById('grid-productos') as HTMLElement;
        const contadorResultados = document.getElementById('contador-resultados') as HTMLElement;
        const sinResultados = document.getElementById('sin-resultados') as HTMLElement;
        const paginacionContainer = document.getElementById('paginacion') as HTMLElement;
        
        const filtrosCategorias = document.querySelectorAll('.filtro-categoria') as NodeListOf<HTMLInputElement>;
        const filtrosMarcas = document.querySelectorAll('.filtro-marca') as NodeListOf<HTMLInputElement>;
        const precioMinInput = document.getElementById('precio-min') as HTMLInputElement;
        const precioMaxInput = document.getElementById('precio-max') as HTMLInputElement;
        const precioMinLabel = document.getElementById('precio-min-label') as HTMLElement;
        const precioMaxLabel = document.getElementById('precio-max-label') as HTMLElement;
        
        const toggleFiltros = document.getElementById('toggle-filtros') as HTMLButtonElement;
        const sidebarFiltros = document.getElementById('sidebar-filtros') as HTMLElement;
        const limpiarFiltrosBtn = document.getElementById('limpiar-filtros') as HTMLButtonElement;
        const resetFiltrosBtn = document.getElementById('reset-filtros') as HTMLButtonElement;

        // Estado
        let categoriasSeleccionadas: string[] = ['todas'];
        let marcasSeleccionadas: string[] = [];
        let precioMinActual = parseInt(precioMinInput?.value || '0');
        let precioMaxActual = parseInt(precioMaxInput?.value || '10000');
        let paginaActual = 1;
        const productosPorPagina = 9;

        // Toggle sidebar mobile
        toggleFiltros?.addEventListener('click', () => {
          sidebarFiltros.classList.toggle('hidden');
        });

        // Accordions
        document.querySelectorAll('.accordion-toggle').forEach(toggle => {
          toggle.addEventListener('click', () => {
            const targetId = (toggle as HTMLElement).dataset.target;
            const content = document.getElementById(targetId || '');
            const icon = toggle.querySelector('.accordion-icon');
            
            content?.classList.toggle('open');
            icon?.classList.toggle('open');
          });
        });

        // Función para normalizar texto
        function normalizarTexto(texto: string): string {
          return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        }

        // Función principal de filtrado
        function filtrarYOrdenar(): void {
          const termino = normalizarTexto(buscador?.value || '');
          const orden = selectOrdenar?.value || 'recientes';
          const tarjetas = Array.from(gridProductos?.querySelectorAll('.producto-card') || []) as HTMLElement[];

          // Crear regex para búsqueda
          let regex: RegExp;
          try {
            regex = new RegExp(termino, 'i');
          } catch {
            regex = new RegExp(termino.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
          }

          // Filtrar
          const tarjetasFiltradas: HTMLElement[] = [];
          
          tarjetas.forEach((tarjeta) => {
            const nombre = tarjeta.dataset.nombre || '';
            const categoria = tarjeta.dataset.categoria || '';
            const marca = tarjeta.dataset.marca || '';
            const precio = parseFloat(tarjeta.dataset.precio || '0');

            const coincideBusqueda = regex.test(normalizarTexto(nombre));
            const coincideCategoria = categoriasSeleccionadas.includes('todas') || categoriasSeleccionadas.includes(categoria);
            const coincideMarca = marcasSeleccionadas.length === 0 || marcasSeleccionadas.includes(marca);
            const coincidePrecio = precio >= precioMinActual && precio <= precioMaxActual;

            if (coincideBusqueda && coincideCategoria && coincideMarca && coincidePrecio) {
              tarjetasFiltradas.push(tarjeta);
            }
          });

          // Ordenar
          tarjetasFiltradas.sort((a, b) => {
            const precioA = parseFloat(a.dataset.precio || '0');
            const precioB = parseFloat(b.dataset.precio || '0');
            const nombreA = a.dataset.nombre || '';
            const nombreB = b.dataset.nombre || '';
            const fechaA = new Date(a.dataset.fecha || '').getTime();
            const fechaB = new Date(b.dataset.fecha || '').getTime();

            switch (orden) {
              case 'precio-asc': return precioA - precioB;
              case 'precio-desc': return precioB - precioA;
              case 'nombre-asc': return nombreA.localeCompare(nombreB);
              default: return fechaB - fechaA;
            }
          });

          // Paginación
          const totalPaginas = Math.ceil(tarjetasFiltradas.length / productosPorPagina);
          if (paginaActual > totalPaginas) paginaActual = 1;
          
          const inicio = (paginaActual - 1) * productosPorPagina;
          const fin = inicio + productosPorPagina;

          // Mostrar/ocultar tarjetas
          tarjetas.forEach(t => t.classList.add('hidden'));
          tarjetasFiltradas.slice(inicio, fin).forEach(t => {
            t.classList.remove('hidden');
            gridProductos?.appendChild(t);
          });

          // Actualizar contador
          if (contadorResultados) {
            contadorResultados.textContent = tarjetasFiltradas.length.toString();
          }

          // Mostrar/ocultar mensaje sin resultados
          if (tarjetasFiltradas.length === 0) {
            sinResultados?.classList.remove('hidden');
          } else {
            sinResultados?.classList.add('hidden');
          }

          // Generar paginación
          generarPaginacion(totalPaginas);
        }

        // Generar controles de paginación
        function generarPaginacion(totalPaginas: number): void {
          if (!paginacionContainer || totalPaginas <= 1) {
            if (paginacionContainer) paginacionContainer.innerHTML = '';
            return;
          }

          let html = '';
          
          // Botón anterior
          html += `<button class="pag-btn p-2 rounded-lg border border-borde hover:bg-panel transition ${paginaActual === 1 ? 'opacity-50 cursor-not-allowed' : ''}" data-pagina="${paginaActual - 1}" ${paginaActual === 1 ? 'disabled' : ''}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          </button>`;

          // Números de página
          for (let i = 1; i <= totalPaginas; i++) {
            if (i === 1 || i === totalPaginas || (i >= paginaActual - 1 && i <= paginaActual + 1)) {
              html += `<button class="pag-btn w-10 h-10 rounded-lg border ${i === paginaActual ? 'bg-acento text-fondo border-acento' : 'border-borde hover:bg-panel'} transition" data-pagina="${i}">${i}</button>`;
            } else if (i === paginaActual - 2 || i === paginaActual + 2) {
              html += `<span class="px-2 text-gris">...</span>`;
            }
          }

          // Botón siguiente
          html += `<button class="pag-btn p-2 rounded-lg border border-borde hover:bg-panel transition ${paginaActual === totalPaginas ? 'opacity-50 cursor-not-allowed' : ''}" data-pagina="${paginaActual + 1}" ${paginaActual === totalPaginas ? 'disabled' : ''}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </button>`;

          paginacionContainer.innerHTML = html;

          // Event listeners para paginación
          paginacionContainer.querySelectorAll('.pag-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const nuevaPagina = parseInt((btn as HTMLElement).dataset.pagina || '1');
              if (nuevaPagina >= 1 && nuevaPagina !== paginaActual) {
                paginaActual = nuevaPagina;
                filtrarYOrdenar();
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }
            });
          });
        }

        // Limpiar filtros
        function limpiarFiltros(): void {
          // Reset categorías
          filtrosCategorias.forEach(cb => {
            cb.checked = cb.value === 'todas';
          });
          categoriasSeleccionadas = ['todas'];

          // Reset marcas
          filtrosMarcas.forEach(cb => cb.checked = false);
          marcasSeleccionadas = [];

          // Reset precios
          if (precioMinInput && precioMaxInput) {
            precioMinInput.value = precioMinInput.min;
            precioMaxInput.value = precioMaxInput.max;
            precioMinActual = parseInt(precioMinInput.min);
            precioMaxActual = parseInt(precioMaxInput.max);
            if (precioMinLabel) precioMinLabel.textContent = precioMinInput.min;
            if (precioMaxLabel) precioMaxLabel.textContent = precioMaxInput.max;
          }

          // Reset búsqueda
          if (buscador) buscador.value = '';

          // Reset ordenación
          if (selectOrdenar) selectOrdenar.value = 'recientes';

          paginaActual = 1;
          filtrarYOrdenar();
        }

        // Event listeners
        buscador?.addEventListener('input', () => { paginaActual = 1; filtrarYOrdenar(); });
        selectOrdenar?.addEventListener('change', () => { paginaActual = 1; filtrarYOrdenar(); });

        // Categorías
        filtrosCategorias.forEach(cb => {
          cb.addEventListener('change', () => {
            if (cb.value === 'todas') {
              if (cb.checked) {
                filtrosCategorias.forEach(c => c.checked = c.value === 'todas');
                categoriasSeleccionadas = ['todas'];
              }
            } else {
              const todasCb = document.querySelector('.filtro-categoria[value="todas"]') as HTMLInputElement;
              if (todasCb) todasCb.checked = false;
              
              categoriasSeleccionadas = Array.from(filtrosCategorias)
                .filter(c => c.checked && c.value !== 'todas')
                .map(c => c.value);
              
              if (categoriasSeleccionadas.length === 0) {
                if (todasCb) todasCb.checked = true;
                categoriasSeleccionadas = ['todas'];
              }
            }
            paginaActual = 1;
            filtrarYOrdenar();
          });
        });

        // Marcas
        filtrosMarcas.forEach(cb => {
          cb.addEventListener('change', () => {
            marcasSeleccionadas = Array.from(filtrosMarcas)
              .filter(c => c.checked)
              .map(c => c.value);
            paginaActual = 1;
            filtrarYOrdenar();
          });
        });

        // Precio
        precioMinInput?.addEventListener('input', () => {
          precioMinActual = parseInt(precioMinInput.value);
          if (precioMinLabel) precioMinLabel.textContent = precioMinInput.value;
          if (precioMinActual > precioMaxActual) {
            precioMaxInput.value = precioMinInput.value;
            precioMaxActual = precioMinActual;
            if (precioMaxLabel) precioMaxLabel.textContent = precioMinInput.value;
          }
          paginaActual = 1;
          filtrarYOrdenar();
        });

        precioMaxInput?.addEventListener('input', () => {
          precioMaxActual = parseInt(precioMaxInput.value);
          if (precioMaxLabel) precioMaxLabel.textContent = precioMaxInput.value;
          if (precioMaxActual < precioMinActual) {
            precioMinInput.value = precioMaxInput.value;
            precioMinActual = precioMaxActual;
            if (precioMinLabel) precioMinLabel.textContent = precioMaxInput.value;
          }
          paginaActual = 1;
          filtrarYOrdenar();
        });

        // Botones limpiar
        limpiarFiltrosBtn?.addEventListener('click', limpiarFiltros);
        resetFiltrosBtn?.addEventListener('click', limpiarFiltros);

        // Carrito
        document.querySelectorAll('.boton-carrito').forEach(boton => {
          boton.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const btn = e.currentTarget as HTMLElement;
            const producto = {
              id: parseInt(btn.dataset.id || '0'),
              nombre: btn.dataset.nombre || '',
              precio: parseFloat(btn.dataset.precio || '0'),
              imagen: btn.dataset.imagen || '',
              slug: btn.dataset.slug || ''
            };
            
            anadirAlCarrito(producto);
            
            if ((window as any).mostrarToast) {
              (window as any).mostrarToast('Producto añadido al carrito');
            }
          });
        });

        // Inicializar
        filtrarYOrdenar();
      </script>
    </>
  )}
</Layout>
