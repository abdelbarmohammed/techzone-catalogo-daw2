---
import Layout from "../layouts/Layout.astro";
import { obtenerDeStrapi, STRAPI_URL_BASE } from "../lib/strapi";

// Tipos
interface CarritoTextos {
  metaTitulo: string;
  metaDescripcion: string;
  titulo: string;
  vacio: string;
  total: string;
  subtotal: string;
  eliminar: string;
  cantidad: string;
  irPagar: string;
  seguirComprando: string;
  pedidoExito: string;
  pedidoExitoMensaje: string;
  volverInicio: string;
}

interface TextosGenerale {
  simboloMoneda: string;
}

// Obtener datos
let carrito: CarritoTextos | null = null;
let textos: TextosGenerale | null = null;
let error = false;

try {
  const resCarrito = await obtenerDeStrapi<CarritoTextos>('carrito');
  carrito = resCarrito.data;
  
  const resTextos = await obtenerDeStrapi<TextosGenerale>('textos-generale');
  textos = resTextos.data;
} catch (e) {
  console.error('Error:', e);
  error = true;
}

const simboloMoneda = textos?.simboloMoneda || '€';
---

<Layout titulo={carrito?.metaTitulo} descripcion={carrito?.metaDescripcion}>
  
  <!-- Background Gradient -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-acento/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/3 left-0 w-[400px] h-[400px] bg-purple-500/5 rounded-full blur-3xl"></div>
  </div>

  {error || !carrito ? (
    <div class="text-center py-20 text-error">
      <p>Error al cargar.</p>
    </div>
  ) : (
    <div class="py-8 animate-fade-in">
      <h1 class="text-3xl md:text-4xl font-bold mb-8">{carrito.titulo}</h1>
      
      <!-- Carrito Vacío -->
      <div id="carrito-vacio" class="hidden text-center py-16">
        <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-panel flex items-center justify-center">
          <svg class="w-12 h-12 text-gris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <p class="text-gris text-lg mb-6">{carrito.vacio}</p>
        <a href="/productos" class="inline-flex items-center gap-2 px-6 py-3 bg-acento text-fondo font-semibold rounded-xl hover:opacity-90 transition">
          {carrito.seguirComprando}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      
      <!-- Pedido Exitoso -->
      <div id="pedido-exito" class="hidden text-center py-16 animate-scale-in">
        <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-green-500/20 flex items-center justify-center">
          <svg class="w-12 h-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-blanco mb-2">{carrito.pedidoExito}</h2>
        <p class="text-gris text-lg mb-6 max-w-md mx-auto">{carrito.pedidoExitoMensaje}</p>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-acento text-fondo font-semibold rounded-xl hover:opacity-90 transition">
          {carrito.volverInicio}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </a>
      </div>
      
      <!-- Carrito con Items -->
      <div id="carrito-contenido" class="hidden">
        <div class="grid lg:grid-cols-3 gap-8">
          
          <!-- Lista de Items -->
          <div class="lg:col-span-2 space-y-4">
            <div id="carrito-items" class="space-y-4"></div>
          </div>
          
          <!-- Resumen -->
          <div class="lg:col-span-1">
            <div class="bg-panel border border-borde rounded-2xl p-6 sticky top-24">
              <h2 class="text-xl font-semibold mb-6">{carrito.subtotal}</h2>
              
              <div class="space-y-3 mb-6">
                <div class="flex justify-between text-gris">
                  <span>{carrito.subtotal}</span>
                  <span id="carrito-subtotal">{simboloMoneda}0</span>
                </div>
                <div class="flex justify-between text-gris">
                  <span>Envío</span>
                  <span class="text-green-400">Gratis</span>
                </div>
                <div class="border-t border-borde pt-4 flex justify-between font-semibold text-xl">
                  <span>{carrito.total}</span>
                  <span id="carrito-total" class="text-acento">{simboloMoneda}0</span>
                </div>
              </div>
              
              <button 
                id="btn-finalizar"
                class="btn-primary w-full py-4 bg-acento text-fondo font-semibold rounded-xl hover:opacity-90 transition mb-3 flex items-center justify-center gap-2"
              >
                <span id="btn-finalizar-texto">{carrito.irPagar}</span>
                <svg id="btn-finalizar-icono" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
                <svg id="btn-finalizar-loading" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
              
              <a 
                href="/productos" 
                class="block w-full py-3 text-center border border-borde text-blanco rounded-xl hover:bg-fondo transition"
              >
                {carrito.seguirComprando}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}
  
  <!-- Pass data to script -->
  <div id="datos-carrito" data-simbolo={simboloMoneda} class="hidden"></div>
</Layout>

<!-- Template para item del carrito -->
<template id="template-item">
  <div class="item-carrito card-hover bg-panel border border-borde rounded-2xl p-4 flex gap-4" data-id="">
    <a href="" class="item-link w-24 h-24 bg-fondo rounded-xl overflow-hidden flex-shrink-0 block">
      <img src="" alt="" class="item-imagen w-full h-full object-contain" />
    </a>
    <div class="flex-grow min-w-0">
      <a href="" class="item-link-nombre block">
        <h3 class="font-semibold text-blanco hover:text-acento transition line-clamp-1 item-nombre"></h3>
      </a>
      <p class="text-gris text-sm mt-1 line-clamp-1 item-descripcion"></p>
      <p class="text-acento font-bold text-lg mt-2 item-precio"></p>
    </div>
    <div class="flex flex-col items-end justify-between flex-shrink-0">
      <button class="btn-eliminar text-gris hover:text-red-400 transition p-2 rounded-lg hover:bg-red-500/10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </button>
      <div class="flex items-center gap-2">
        <button class="btn-menos w-9 h-9 rounded-xl border border-borde hover:bg-acento hover:text-fondo hover:border-acento transition flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
          </svg>
        </button>
        <span class="item-cantidad w-8 text-center font-semibold"></span>
        <button class="btn-mas w-9 h-9 rounded-xl border border-borde hover:bg-acento hover:text-fondo hover:border-acento transition flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</template>

<script>
  import { obtenerCarrito, eliminarDelCarrito, actualizarCantidad, obtenerPrecioTotal, vaciarCarrito } from '../lib/carrito';
  
  // Obtener símbolo de moneda desde el DOM (viene de Strapi)
  const datosCarrito = document.getElementById('datos-carrito') as HTMLElement;
  const simboloMoneda = datosCarrito?.dataset.simbolo || '€';
  
  // Elementos del DOM
  const carritoVacio = document.getElementById('carrito-vacio');
  const carritoContenido = document.getElementById('carrito-contenido');
  const pedidoExito = document.getElementById('pedido-exito');
  const carritoItems = document.getElementById('carrito-items');
  const carritoSubtotal = document.getElementById('carrito-subtotal');
  const carritoTotal = document.getElementById('carrito-total');
  const template = document.getElementById('template-item') as HTMLTemplateElement;
  const btnFinalizar = document.getElementById('btn-finalizar') as HTMLButtonElement;
  const btnFinalizarTexto = document.getElementById('btn-finalizar-texto');
  const btnFinalizarIcono = document.getElementById('btn-finalizar-icono');
  const btnFinalizarLoading = document.getElementById('btn-finalizar-loading');
  
  // Renderizar carrito
  function renderizarCarrito(): void {
    const items = obtenerCarrito();
    
    if (items.length === 0) {
      carritoVacio?.classList.remove('hidden');
      carritoContenido?.classList.add('hidden');
      pedidoExito?.classList.add('hidden');
      return;
    }
    
    carritoVacio?.classList.add('hidden');
    carritoContenido?.classList.remove('hidden');
    pedidoExito?.classList.add('hidden');
    
    // Limpiar items actuales
    if (carritoItems) {
      carritoItems.innerHTML = '';
      
      // Renderizar cada item
      items.forEach((item, index) => {
        const clone = template.content.cloneNode(true) as DocumentFragment;
        const div = clone.querySelector('.item-carrito') as HTMLElement;
        
        // Añadir animación escalonada
        div.style.animationDelay = `${index * 0.05}s`;
        div.classList.add('animate-slide-up');
        
        div.dataset.id = item.id.toString();
        
        const imagen = clone.querySelector('.item-imagen') as HTMLImageElement;
        imagen.src = item.imagen;
        imagen.alt = item.nombre;
        
        // Links al producto
        const links = clone.querySelectorAll('.item-link, .item-link-nombre');
        links.forEach(link => {
          (link as HTMLAnchorElement).href = `/productos/${item.slug}`;
        });
        
        (clone.querySelector('.item-nombre') as HTMLElement).textContent = item.nombre;
        (clone.querySelector('.item-precio') as HTMLElement).textContent = `${simboloMoneda}${(item.precio * item.cantidad).toLocaleString()}`;
        (clone.querySelector('.item-cantidad') as HTMLElement).textContent = item.cantidad.toString();
        
        // Event listeners
        clone.querySelector('.btn-eliminar')?.addEventListener('click', () => {
          eliminarDelCarrito(item.id);
          renderizarCarrito();
          actualizarContadorCarrito();
        });
        
        clone.querySelector('.btn-menos')?.addEventListener('click', () => {
          actualizarCantidad(item.id, item.cantidad - 1);
          renderizarCarrito();
          actualizarContadorCarrito();
        });
        
        clone.querySelector('.btn-mas')?.addEventListener('click', () => {
          actualizarCantidad(item.id, item.cantidad + 1);
          renderizarCarrito();
          actualizarContadorCarrito();
        });
        
        carritoItems.appendChild(clone);
      });
    }
    
    // Actualizar totales
    const total = obtenerPrecioTotal();
    if (carritoSubtotal) carritoSubtotal.textContent = `${simboloMoneda}${total.toLocaleString()}`;
    if (carritoTotal) carritoTotal.textContent = `${simboloMoneda}${total.toLocaleString()}`;
  }
  
  // Actualizar contador en el header
  function actualizarContadorCarrito(): void {
    window.dispatchEvent(new CustomEvent('carrito-actualizado'));
  }
  
  // Finalizar compra
  btnFinalizar?.addEventListener('click', async () => {
    // Mostrar loading
    btnFinalizar.disabled = true;
    btnFinalizarTexto?.classList.add('hidden');
    btnFinalizarIcono?.classList.add('hidden');
    btnFinalizarLoading?.classList.remove('hidden');
    
    // Simular procesamiento
    await new Promise(resolve => setTimeout(resolve, 2000));
    
    // Vaciar carrito
    vaciarCarrito();
    actualizarContadorCarrito();
    
    // Mostrar éxito
    carritoContenido?.classList.add('hidden');
    pedidoExito?.classList.remove('hidden');
    
    // Restaurar botón
    btnFinalizar.disabled = false;
    btnFinalizarTexto?.classList.remove('hidden');
    btnFinalizarIcono?.classList.remove('hidden');
    btnFinalizarLoading?.classList.add('hidden');
  });
  
  // Escuchar cambios en el carrito
  window.addEventListener('carrito-actualizado', () => {
    renderizarCarrito();
  });
  
  // Renderizar al cargar
  renderizarCarrito();
</script>