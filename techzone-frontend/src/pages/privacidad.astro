---
import Layout from "../layouts/Layout.astro";
import { obtenerDeStrapi } from "../lib/strapi";

interface ConfiguracionSitio {
  nombreSitio: string;
  emailContacto: string;
}

let config: ConfiguracionSitio | null = null;
try {
  const res = await obtenerDeStrapi<ConfiguracionSitio>('configuracion-sitio');
  config = res.data;
} catch (e) {}

const nombreSitio = config?.nombreSitio || 'GaleríaTech';
const email = config?.emailContacto || 'info@galeriatech.es';
---

<Layout titulo={`Política de Privacidad | ${nombreSitio}`} descripcion="Política de privacidad y protección de datos personales.">
  <div class="max-w-3xl mx-auto py-8 animate-fade-in">
    <h1 class="text-3xl font-bold mb-8">Política de Privacidad</h1>
    
    <div class="prose prose-invert space-y-6 text-gris">
      <p class="text-blanco">Última actualización: Febrero 2026</p>
      
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-blanco">1. Responsable del Tratamiento</h2>
        <p>{nombreSitio} es responsable del tratamiento de los datos personales recogidos a través de este sitio web.</p>
        <p>Contacto: <a href={`mailto:${email}`} class="text-acento hover:underline">{email}</a></p>
      </section>
      
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-blanco">2. Datos que Recopilamos</h2>
        <ul class="list-disc list-inside space-y-1">
          <li>Datos de contacto: nombre, email, teléfono</li>
          <li>Datos de envío: dirección, ciudad, código postal</li>
          <li>Datos de navegación: cookies técnicas</li>
        </ul>
      </section>
      
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-blanco">3. Finalidad del Tratamiento</h2>
        <ul class="list-disc list-inside space-y-1">
          <li>Gestionar pedidos y envíos</li>
          <li>Responder consultas del formulario de contacto</li>
          <li>Mejorar la experiencia de usuario</li>
        </ul>
      </section>
      
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-blanco">4. Base Legal</h2>
        <p>El tratamiento de datos se basa en el consentimiento del usuario y la ejecución de un contrato de compraventa.</p>
      </section>
      
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-blanco">5. Derechos del Usuario</h2>
        <p>Puedes ejercer tus derechos de acceso, rectificación, supresión, oposición y portabilidad enviando un email a <a href={`mailto:${email}`} class="text-acento hover:underline">{email}</a>.</p>
      </section>
      
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-blanco">6. Cookies</h2>
        <p>Este sitio utiliza cookies técnicas necesarias para su funcionamiento. No utilizamos cookies de seguimiento ni publicidad.</p>
      </section>
    </div>
    
    <div class="mt-12 pt-6 border-t border-borde">
      <a href="/" class="text-acento hover:underline">← Volver al inicio</a>
    </div>
  </div>
</Layout>
