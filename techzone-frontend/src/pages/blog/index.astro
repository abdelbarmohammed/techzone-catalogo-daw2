---
import Layout from "../../layouts/Layout.astro";
import { obtenerDeStrapi, STRAPI_URL_BASE } from "../../lib/strapi";

// Tipos
interface Articulo {
  id: number;
  titulo: string;
  slug: string;
  extracto: string;
  autor: string;
  fechaPublicacion: string;
  contenido: any[];
  imagen: { url: string };
  destacado: boolean;
  createdAt: string;
}

interface TextosGenerale {
  tiempoLectura: string;
  verMas: string;
  noResultados: string;
  buscarPlaceholder: string;
  leerArticulo: string;
  todosArticulos: string;
}

// Obtener datos
let articulos: Articulo[] = [];
let articuloDestacado: Articulo | null = null;
let textos: TextosGenerale | null = null;
let error = false;

try {
  const resArticulos = await obtenerDeStrapi<Articulo[]>('articulos', 'populate=*&sort=fechaPublicacion:desc');
  articulos = resArticulos.data;

  // Separar artículo destacado
  articuloDestacado = articulos.find(a => a.destacado) || articulos[0] || null;
  articulos = articulos.filter(a => a.id !== articuloDestacado?.id);

  const resTextos = await obtenerDeStrapi<TextosGenerale>('textos-generale');
  textos = resTextos.data;
} catch (e) {
  console.error('Error:', e);
  error = true;
}

// Calcular tiempo de lectura
function calcularTiempoLectura(contenido: any[]): number {
  if (!contenido || !Array.isArray(contenido)) return 1;
  
  const texto = contenido.map(bloque => {
    if (bloque.children) {
      return bloque.children.map((child: any) => child.text || '').join(' ');
    }
    return '';
  }).join(' ');
  
  const palabras = texto.split(/\s+/).filter(Boolean).length;
  const minutos = Math.ceil(palabras / 200);
  return minutos < 1 ? 1 : minutos;
}

// Formatear fecha
function formatearFecha(fecha: string): string {
  if (!fecha) return '';
  return new Date(fecha).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

const metaTitulo = "Blog | GaleríaTech";
const metaDescripcion = "Artículos sobre tecnología, novedades y guías de productos tech.";
---

<Layout titulo={metaTitulo} descripcion={metaDescripcion}>
  
  {error ? (
    <div class="text-center py-20 text-error">
      <p>Error al cargar los artículos.</p>
    </div>
  ) : (
    <>
      <!-- Hero Article -->
      {articuloDestacado && (
        <section class="relative -mx-4 sm:-mx-6 lg:-mx-8 mb-12 animate-fade-in">
          <a href={`/blog/${articuloDestacado.slug}`} class="block group">
            <div class="relative h-[500px] md:h-[600px] overflow-hidden">
              <!-- Background Image -->
              {articuloDestacado.imagen?.url && (
                <img
                  src={`${STRAPI_URL_BASE}${articuloDestacado.imagen.url}`}
                  alt={articuloDestacado.titulo}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
              )}
              
              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-fondo via-fondo/60 to-transparent"></div>
              <div class="absolute inset-0 bg-gradient-to-r from-fondo/80 to-transparent"></div>
              
              <!-- Content -->
              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12 lg:p-16">
                <div class="max-w-3xl">
                  <!-- Badge -->
                  <div class="flex items-center gap-3 mb-4">
                    <span class="px-3 py-1 bg-acento text-fondo text-xs font-semibold rounded-full uppercase tracking-wide">
                      Destacado
                    </span>
                    <span class="text-gris text-sm">
                      {formatearFecha(articuloDestacado.fechaPublicacion || articuloDestacado.createdAt)}
                    </span>
                  </div>
                  
                  <!-- Title -->
                  <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-blanco mb-4 leading-tight group-hover:text-acento transition-colors duration-300">
                    {articuloDestacado.titulo}
                  </h1>
                  
                  <!-- Excerpt -->
                  <p class="text-gris text-lg mb-6 line-clamp-2 max-w-2xl">
                    {articuloDestacado.extracto}
                  </p>
                  
                  <!-- CTA -->
                  <div class="flex items-center gap-4">
                    <span class="inline-flex items-center gap-2 px-6 py-3 bg-blanco/10 backdrop-blur-sm border border-blanco/20 text-blanco rounded-xl group-hover:bg-acento group-hover:border-acento group-hover:text-fondo transition-all duration-300">
                      {textos?.leerArticulo || 'Leer artículo completo'}
                      <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </span>
                    <span class="text-gris text-sm flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {calcularTiempoLectura(articuloDestacado.contenido)} min
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- Section Header -->
      <section class="mb-8 animate-slide-up">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold">{textos?.todosArticulos || 'Todos los Artículos'}</h2>
            <p class="text-gris text-sm mt-1">Descubre las últimas novedades y guías</p>
          </div>
          
          <!-- Search -->
          <div class="relative max-w-sm w-full">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="buscador"
              placeholder={textos?.buscarPlaceholder || 'Buscar artículos...'}
              class="w-full pl-12 pr-4 py-3 bg-panel border border-borde rounded-xl text-blanco placeholder:text-gris focus:outline-none focus:border-acento transition"
            />
          </div>
        </div>
      </section>

      {articulos.length === 0 && !articuloDestacado ? (
        <div class="text-center py-20">
          <svg class="w-16 h-16 mx-auto text-gris mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <p class="text-gris text-lg">No hay artículos publicados todavía.</p>
        </div>
      ) : (
        <>
          <!-- Grid de Artículos -->
          <section id="grid-articulos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            {articulos.map((articulo, index) => (
              <article
                class="articulo-card card-hover group bg-panel rounded-2xl border border-borde overflow-hidden stagger-item"
                data-titulo={articulo.titulo.toLowerCase()}
                data-extracto={articulo.extracto.toLowerCase()}
                style={`animation-delay: ${index * 0.1}s;`}
              >
                <a href={`/blog/${articulo.slug}`} class="block">
                  <!-- Imagen -->
                  <div class="aspect-video bg-fondo relative overflow-hidden">
                    {articulo.imagen?.url && (
                      <img
                        src={`${STRAPI_URL_BASE}${articulo.imagen.url}`}
                        alt={articulo.titulo}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    )}
                    <!-- Reading time badge -->
                    <div class="absolute top-3 right-3 px-2 py-1 bg-fondo/80 backdrop-blur-sm rounded-lg text-xs text-blanco flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {calcularTiempoLectura(articulo.contenido)} min
                    </div>
                  </div>
                  
                  <!-- Contenido -->
                  <div class="p-5">
                    <!-- Meta -->
                    <div class="flex items-center gap-3 text-xs text-gris mb-3">
                      <span>{formatearFecha(articulo.fechaPublicacion || articulo.createdAt)}</span>
                    </div>
                    
                    <!-- Título -->
                    <h3 class="text-lg font-semibold text-blanco group-hover:text-acento transition mb-2 line-clamp-2">
                      {articulo.titulo}
                    </h3>
                    
                    <!-- Extracto -->
                    <p class="text-gris text-sm line-clamp-2 mb-4">
                      {articulo.extracto}
                    </p>
                    
                    <!-- Autor -->
                    <div class="flex items-center gap-3 pt-4 border-t border-borde">
                      <div class="w-8 h-8 rounded-full bg-acento/20 flex items-center justify-center">
                        <span class="text-acento text-sm font-medium">
                          {articulo.autor.charAt(0).toUpperCase()}
                        </span>
                      </div>
                      <div>
                        <span class="text-sm text-blanco">{articulo.autor}</span>
                      </div>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </section>

          <!-- Mensaje Sin Resultados -->
          <div id="sin-resultados" class="hidden text-center py-16">
            <svg class="w-16 h-16 mx-auto text-gris mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-gris text-lg">{textos?.noResultados || 'No se encontraron artículos.'}</p>
          </div>
        </>
      )}
    </>
  )}

  <!-- Script de búsqueda -->
  <script>
    const buscador = document.getElementById('buscador') as HTMLInputElement;
    const gridArticulos = document.getElementById('grid-articulos') as HTMLElement;
    const sinResultados = document.getElementById('sin-resultados') as HTMLElement;

    function normalizarTexto(texto: string): string {
      return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    }

    function filtrarArticulos(): void {
      if (!gridArticulos) return;
      
      const termino = normalizarTexto(buscador?.value || '');
      const tarjetas = Array.from(gridArticulos.querySelectorAll('.articulo-card')) as HTMLElement[];

      let regex: RegExp;
      try {
        regex = new RegExp(termino, 'i');
      } catch {
        regex = new RegExp(termino.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
      }

      let visibles = 0;
      tarjetas.forEach((tarjeta) => {
        const titulo = tarjeta.dataset.titulo || '';
        const extracto = tarjeta.dataset.extracto || '';
        const coincide = regex.test(normalizarTexto(titulo)) || regex.test(normalizarTexto(extracto));

        if (coincide) {
          tarjeta.classList.remove('hidden');
          visibles++;
        } else {
          tarjeta.classList.add('hidden');
        }
      });

      if (sinResultados) {
        if (visibles === 0 && termino) {
          sinResultados.classList.remove('hidden');
        } else {
          sinResultados.classList.add('hidden');
        }
      }
    }

    buscador?.addEventListener('input', filtrarArticulos);
  </script>
</Layout>
