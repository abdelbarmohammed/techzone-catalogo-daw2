{
  "kind": "singleType",
  "collectionName": "pagina_inicios",
  "info": {
    "singularName": "pagina-inicio",
    "pluralName": "pagina-inicios",
    "displayName": "PaginaInicio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroTitulo": {
      "type": "string",
      "required": true
    },
    "heroSubtitulo": {
      "type": "text",
      "required": true
    },
    "heroBadge": {
      "type": "string",
      "required": true
    },
    "heroBotonPrimario": {
      "type": "string",
      "required": true
    },
    "heroBotonPrimarioEnlace": {
      "type": "string",
      "default": "/productos"
    },
    "heroBotonSecundario": {
      "type": "string",
      "required": true
    },
    "heroBotonSecundarioEnlace": {
      "type": "string",
      "default": "#categorias"
    },
    "heroImagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "estadisticas": {
      "type": "component",
      "repeatable": true,
      "component": "inicio.estadistica"
    },
    "beneficios": {
      "type": "component",
      "repeatable": true,
      "component": "inicio.beneficio"
    },
    "categoriasSeccionTitulo": {
      "type": "string",
      "required": true
    },
    "categoriasSeccionSubtitulo": {
      "type": "string"
    },
    "productosSeccionTitulo": {
      "type": "string",
      "required": true
    },
    "productosSeccionSubtitulo": {
      "type": "string"
    },
    "bannerEtiqueta": {
      "type": "string"
    },
    "bannerTitulo": {
      "type": "string"
    },
    "bannerSubtitulo": {
      "type": "text"
    },
    "bannerBoton": {
      "type": "string"
    },
    "bannerEnlace": {
      "type": "string"
    },
    "bannerImagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "marcasSeccionTitulo": {
      "type": "string"
    },
    "marcasSeccionSubtitulo": {
      "type": "string"
    },
    "blogSeccionTitulo": {
      "type": "string"
    },
    "blogSeccionSubtitulo": {
      "type": "string"
    },
    "newsletterTitulo": {
      "type": "string",
      "required": true
    },
    "newsletterSubtitulo": {
      "type": "text"
    },
    "newsletterBoton": {
      "type": "string",
      "required": true
    },
    "newsletterPlaceholder": {
      "type": "string"
    },
    "newsletterNota": {
      "type": "string"
    },
    "metaTitulo": {
      "type": "string"
    },
    "metaDescripcion": {
      "type": "text"
    }
  }
}
